/**
 * PAGEVOYAGE SECURITY RULES
 * 
 * CORE PHILOSOPHY:
 * This ruleset implements an "Authorization Independence" model. By denormalizing critical 
 * fields like `userId` and `facilityId` directly onto documents, we ensure that security 
 * decisions are performant and do not require excessive `get()` lookups. 
 * 
 * DATA STRUCTURE:
 * - /users/{userId}: Private user profiles.
 * - /visits/{visitId}: Visit logs with denormalized user and facility links.
 * - /user_sessions/{sessionId}: Real-time session tracking for the admin dashboard.
 * 
 * KEY SECURITY DECISIONS:
 * 1. Role-Based Access Control (RBAC): We check the 'role' field in the /users/{userId} document
 *    to grant administrative privileges.
 * 2. Ownership Enforcement: Users are strictly limited to creating and managing data 
 *    linked to their own `auth.uid`.
 * 3. Administrative Oversight: Global admins have broad read/write access across the system 
 *    to manage users and monitor sessions.
 * 4. Real-time Dashboard Support: The `user_sessions` rules permit admins and limited-query users
 *    to perform global queries to support the live dashboard.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the authenticated user is a global administrator based on their user profile. */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    /** Checks if the authenticated user is a manager for a specific facility. */
    // Note: Facility management currently relies on isAdmin for simplicity in this prototype
    function isFacilityManager(facilityId) {
      return isAdmin();
    }

    /** Verifies ownership on an existing document for update/delete operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.id == userId;
      allow delete: if isAdmin();
    }

    /**
     * @description Publicly readable facility information.
     * @path /facilities/{facilityId}
     */
    match /facilities/{facilityId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Visit logs tracking user activity at facilities.
     * @path /visits/{visitId}
     */
    match /visits/{visitId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if resource != null && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Real-time session tracking for the Admin dashboard.
     * @path /user_sessions/{sessionId}
     */
    match /user_sessions/{sessionId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100); 
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if resource != null && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAdmin() && resource != null;
    }
  }
}