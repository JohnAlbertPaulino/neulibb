
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the CampusFlow application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "The institutional email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (ADMIN or VISITOR)."
        },
        "collegeDepartment": {
          "type": "string",
          "description": "The college department the user belongs to."
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Indicates if the user account is blocked."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "role",
        "isBlocked",
        "createdAt"
      ]
    },
    "Facility": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Facility",
      "type": "object",
      "description": "Represents a physical location like Library or Dean's Office.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "Visit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Visit",
      "type": "object",
      "description": "Records details of a visitor checking into a facility.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "visitorName": {
          "type": "string"
        },
        "visitorType": {
          "type": "string",
          "enum": ["Student", "Teacher", "Staff"],
          "description": "Distinguishes between students and employees (Teacher/Staff)."
        },
        "department": {
          "type": "string",
          "description": "The department the visitor is affiliated with."
        },
        "facility": {
          "type": "string",
          "enum": ["Library", "Dean's Office"]
        },
        "checkInTime": {
          "type": "string",
          "format": "date-time"
        },
        "reasonForVisit": {
          "type": "string"
        },
        "purposeCategory": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "visitorName",
        "visitorType",
        "department",
        "facility",
        "checkInTime",
        "reasonForVisit",
        "status"
      ]
    },
    "UserSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserSession",
      "type": "object",
      "description": "Tracks active login sessions.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "loginTime": {
          "type": "string",
          "format": "date-time"
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "loginTime",
        "isActive"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          }
        }
      },
      {
        "path": "/visits/{visitId}",
        "definition": {
          "entityName": "Visit",
          "schema": {
            "$ref": "#/backend/entities/Visit"
          }
        }
      },
      {
        "path": "/user_sessions/{sessionId}",
        "definition": {
          "entityName": "UserSession",
          "schema": {
            "$ref": "#/backend/entities/UserSession"
          }
        }
      }
    ]
  }
}
